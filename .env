# ==============================================================================
# PNG to SVG Floor Map Processor Configuration
# ==============================================================================

# Mode Selection: 'single-tenant' (default) or 'multi-tenant'
MODE=single-tenant

# ------------------------------------------------------------------------------
# Single-Tenant Configuration
# ------------------------------------------------------------------------------
# Base API URL for single-tenant migration endpoint
BASE_URL="http://host.docker.internal:8888/api/v1/migration"

# ------------------------------------------------------------------------------
# Multi-Tenant Configuration
# ------------------------------------------------------------------------------
# Base URL of the multi-tenant cloud environment
MULTI_TENANT_BASEURL=https://qa-tenant2.sclera.com

# Multi-Tenant VDMS Filter (Optional):
# Filter processing for specific VDMS box(es).
# Supports single VDMS (e.g. VDMS885), comma-separated list (e.g. VDMS885,VDMS886), or JSON list (e.g. ["VDMS885", "VDMS886"]).
# Leave empty to process all VDMS boxes.
VDMS_FILTER=

# ------------------------------------------------------------------------------
# Conversion Engine Configuration
# ------------------------------------------------------------------------------
# Engine to use: 'potrace' (default) or 'vtracer'
CONVERSION_ENGINE=potrace

# Auto-detect engine: when true, automatically selects 'vtracer' for color images
# and 'potrace' for grayscale/black-and-white architectural plans.
AUTO_DETECT_ENGINE=true

# SVG Optimization: enable SVGO optimization in addition to svgcleaner
ENABLE_SVGO=true
